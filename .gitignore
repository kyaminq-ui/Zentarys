# Godot 4+ specific ignores
.godot/
/android/

# Analyse externe et binaire de l'editeur : references locales, hors depot
CubeWorld-Reversal-master/
godot.windows.editor.double.x86_64.exe

# Caches de l'interpreteur Python des outils de generation
__pycache__/
*.pyc

# Captures du jeu d'origine, gardees en local comme references de mesure.
# Elles ne partent pas au depot : le cadre du projet est qu'aucun asset de
# l'original n'y entre, et une capture d'ecran en est un. On en tire des
# nombres — un rapport de tailles, un compte de cubes —, jamais des pixels.
reference_*.png
# Et les fichiers d'import que Godot genere pour elles : la capture est ignoree,
# son `.import` ne l'etait pas, et il se serait retrouve au depot tout seul.
reference_*.png.import

# La GDExtension (`native/`). Le code source y est ; la dependance, le vidage
# d'API et les objets compiles n'y sont pas, et pour la meme raison que le
# binaire de l'editeur juste au-dessus : ils decrivent une machine, pas le
# projet. `native/README.md` dit comment les refaire, et le monde est identique
# sans eux — seulement plus lent a charger.
native/godot-cpp/
native/api/
native/bin/
# Le manifeste est **pose par la construction**, pas versionne : Godot lit tout
# `.gdextension` qu'il trouve, et un manifeste sans bibliotheque fait une erreur
# a chaque demarrage. Le modele versionne est `zentarys.gdextension.in`.
native/zentarys.gdextension
native/zentarys.gdextension.uid
native/.sconsign.dblite
native/src/*.obj
native/src/*.o
